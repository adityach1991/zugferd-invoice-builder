# Application environment: development | test | production
NODE_ENV=development

# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zugferd_dev?schema=public"

# C# ZUGFeRD worker (workers/zugferd-dotnet)
ZUGFERD_WORKER_URL="http://localhost:5100"
ZUGFERD_WORKER_TIMEOUT_MS=30000

# S3-compatible object storage (private)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_BUCKET="zugferd-invoices"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"

# Logging: debug | info | warn | error
LOG_LEVEL=info
